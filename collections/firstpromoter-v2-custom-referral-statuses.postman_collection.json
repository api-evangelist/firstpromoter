        {
          "id": "2e70c30a-0341-466d-92c2-4e27851a7f70",
          "name": "Create, update, or delete custom referral statuses",
          "request": {
            "name": "Create, update, or delete custom referral statuses",
            "description": {
              "content": "Batch operation to create, update, and/or delete custom referral statuses in a single request. Pass an array of status objects under the `custom_referral_statuses` key.\n\n- **Create**: omit `id`\n- **Update**: include the existing `id`\n- **Delete**: include `id` and set `_destroy` to `true`\n\n <Note>Both `name` and `order` must be unique within your account. Leading and trailing whitespace is stripped from `name`.</Note>\n\n <Tip>**HTTP Request** <br/>`PUT https://api.firstpromoter.com/api/admin/v1/custom_referral_statuses/update`</Tip>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "custom_referral_statuses",
                "update"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Your FirstPromoter Account ID. Found in Settings → Integrations.",
                "key": "Account-ID",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"custom_referral_statuses\": [\n    {\n      \"name\": \"<string>\",\n      \"order\": \"<integer>\",\n      \"id\": \"<integer>\",\n      \"description\": \"<string>\",\n      \"_destroy\": \"<boolean>\"\n    },\n    {\n      \"name\": \"<string>\",\n      \"order\": \"<integer>\",\n      \"id\": \"<integer>\",\n      \"description\": \"<string>\",\n      \"_destroy\": \"<boolean>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
