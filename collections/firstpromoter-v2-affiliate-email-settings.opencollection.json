{
  "opencollection": "1.0.0",
  "info": {
    "name": "FirstPromoter Email Settings API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Email Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
