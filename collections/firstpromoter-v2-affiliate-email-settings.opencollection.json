                "description": "Encrypted email"
              }
            ]
          },
          "docs": "Get affiliate email settings"
        },
        {
          "info": {
            "name": "Update affiliate email settings",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.firstpromoter.com/api/v2/affiliate/email_settings/:id",
            "headers": [
              {
                "name": "Account-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Promoter ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update affiliate email settings"
        }
      ]
    }
  ],
  "bundled": true
}